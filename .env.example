PORT=4000
DATABASE_URL=postgres://localhost:5433/alastudie
ADMIN_EMAILS=admin@alastudie.local
LOCAL_MAILBOX_ENABLED=true
SESSION_HOURS=720

# Gemini is intentionally fail-closed. Only fill these after verifying eligible
# credit, disabling auto-reload, and setting a Google Cloud spend cap.
GEMINI_API_KEY=
GEMINI_CREDITS_CONFIRMED=false
GEMINI_SPEND_CAP_CONFIGURED=false
GEMINI_BUDGET_USD=
GEMINI_BUDGET_RESERVE_USD=
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
GEMINI_EMBEDDING_USD_PER_MILLION=
# Optional overrides: GEMINI_MODEL, GEMINI_EMBEDDING_MODEL
